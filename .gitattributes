# Auto detect text files and perform LF normalization
* text=auto

# Generated by the app in debug and compared byte for byte by its
# bindings test, so it checks out with LF on every OS.
app/src/bindings.ts text eol=lf

# Read by a test with include_str! and compared with the probe's header.
crates/zootr/src/shops/floors/table.rs text eol=lf
