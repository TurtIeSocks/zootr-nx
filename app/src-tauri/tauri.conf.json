{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zootr-nx",
  "identifier": "io.github.turtiesocks.zootr-nx",
  "build": {
    "devUrl": "http://localhost:1620",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zootr-nx",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 }
      },
      {
        "label": "tracker",
        "title": "zootr-nx items",
        "create": false,
        "width": 480,
        "height": 600,
        "resizable": true
      },
      {
        "label": "dev",
        "title": "zootr-nx dev",
        "create": false,
        "width": 400,
        "height": 760,
        "minWidth": 340,
        "minHeight": 400,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        {
          "identifier": "drag",
          "description": "The main window moves by its sidebar top and topbar, marked data-tauri-drag-region.",
          "windows": ["main"],
          "permissions": ["core:window:allow-start-dragging"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "../../crates/zootr/live.entitlements"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMDhBQ0U0NUE3N0Y4QzkKUldUSitIZGE1S3dJdnJmakpXWVo2UURjTmQ5VEhOMWJQOTNPazh3Q0VwOUlwcHh6eEpKZXA2NXQK",
      "endpoints": ["https://github.com/TurtIeSocks/zootr-nx/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
